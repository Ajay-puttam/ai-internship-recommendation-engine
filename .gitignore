# Root .gitignore for major_project1

# Python/FastAPI
backend/venv/
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.pytest_cache/
backend/.env
backend/*.log
backend/out_*.txt
backend/startup.txt

# Node/Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# Database
database/*.db
database/*.sqlite3

# OS Files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
